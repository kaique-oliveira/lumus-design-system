{
  "name": "@lumus-ui/tokens",
  "version": "2.0.0",
  "description": "Tokens de design do Lumus em TypeScript e em CSS para Tailwind v4",
  "license": "MIT",
  "author": "Kaique Oliveira",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "build": "tsdown && tsx scripts/build-theme.ts",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "tsdown": "0.23.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
