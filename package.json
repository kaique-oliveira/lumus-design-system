{
  "name": "lumus-design-system",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "sem-travessao": "bash scripts/check-dash.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=!@lumus-ui/docs && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.13",
    "turbo": "2.10.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "6.0.3"
    }
  }
}
